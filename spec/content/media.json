  {
    "id": "med-img-chart-monthly-starts",
    "type": "image",
    "kind": "chart",
    "format": "png",
    "title": "Chart - Apprenticeship starts by month",
    "site": "hub",
    "library": "Brand & Comms",
    "folder": "Charts/2026-11",
    "category": "Chart",
    "author": "P027",
    "created": "2026-11-04",
    "modified": "2026-11-04",
    "classification": "Internal",
    "tags": [
      "chart",
      "starts",
      "news",
      "digest",
      "data"
    ],
    "summary": "Chart image of new apprenticeship starts per month (November 2025 to October 2026) for use in the Delcorn Digest and news posts.",
    "chart": {
      "type": "column",
      "title": "New apprenticeship starts by month",
      "subtitle": "November 2025 - October 2026, all academies",
      "sql": "SELECT substr('JanFebMarAprMayJunJulAugSepOctNovDec', 3*CAST(substr(start_date,6,2) AS INTEGER)-2, 3) || ' ' || substr(start_date,3,2) AS Month, COUNT(*) AS Starts FROM learners WHERE start_date BETWEEN '2025-11-01' AND '2026-10-31' GROUP BY substr(start_date,1,7) ORDER BY substr(start_date,1,7)",
      "source": "Aptiva learner register"
    }
  },
