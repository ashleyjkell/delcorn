  {
    "id": "med-scan-complaints-policy-2019",
    "type": "scan",
    "format": "pdf",
    "quality": "poor",
    "title": "Complaints Procedure v1.2 (2019) - SUPERSEDED",
    "site": "quality",
    "library": "Policies & Procedures",
    "folder": "Archive/Superseded",
    "category": "Policy",
    "doc_type_label": "Superseded policy (scanned paper copy)",
    "author": "P001",
    "created": "2019-03-01",
    "modified": "2023-08-01",
    "version": "1.2",
    "status": "Superseded",
    "classification": "Internal",
    "tags": [
      "complaints",
      "superseded",
      "archive",
      "2019",
      "scanned"
    ],
    "summary": "Scanned paper copy of the 2019 Complaints Procedure, stamped SUPERSEDED in August 2023. Kept for audit history only - see the current Complaints Policy.",
    "letterhead": true,
    "show_title": true,
    "blocks": [
      {
        "kv": [
          [
            "Version",
            "1.2"
          ],
          [
            "Effective from",
            "1 March 2019"
          ],
          [
            "Owner",
            "Managing Director"
          ],
          [
            "Next review",
            "March 2020"
          ]
        ]
      },
      {
        "h2": "1. Purpose"
      },
      {
        "p": "Delcorn aims to provide an excellent service to every apprentice and employer. If something goes wrong we want to know, so that we can put it right and learn from it."
      },
      {
        "h2": "2. How to complain"
      },
      {
        "p": "Complaints should be made in writing, by letter to the Managing Director at our office or by email to info@delcorn.co.uk. Please give your name, employer, programme and details of the complaint."
      },
      {
        "h2": "3. Stages and timescales"
      },
      {
        "table": {
          "columns": [
            "Stage",
            "Handled by",
            "Timescale"
          ],
          "rows": [
            [
              "Stage 1 - Formal complaint",
              "Programme Manager",
              "Acknowledged within 5 working days; response within 20 working days"
            ],
            [
              "Stage 2 - Appeal",
              "Managing Director",
              "Appeal within 20 working days of Stage 1 response; decision within 20 working days"
            ],
            [
              "Stage 3 - External",
              "Education and Skills Funding Agency (ESFA) complaints team",
              "When Delcorn's procedure is exhausted"
            ]
          ]
        }
      },
      {
        "h2": "4. Records"
      },
      {
        "p": "The Programme Manager keeps a paper log of complaints, which is reviewed by the Managing Director every six months."
      },
      {
        "signature": "P001",
        "date": "2019-03-01",
        "ink": "black"
      },
      {
        "spacer": 160
      },
      {
        "stamp": "SUPERSEDED",
        "date": "2023-08-01"
      },
      {
        "hand": "SUPERSEDED - replaced by Complaints Policy (Aug 2023). Do not issue to learners. HP",
        "ink": "red"
      }
    ]
  },
