      "achievement",
      "academies",
      "news",
      "data"
    ],
    "summary": "Chart image of the 2025/26 achievement rate by academy for news posts and the annual review.",
    "chart": {
      "type": "column",
      "title": "Achievement rate by academy, 2025/26 (%)",
      "subtitle": "Completed / (completed + withdrawn), leavers 1 Aug 2025 - 31 Jul 2026",
      "sql": "SELECT REPLACE(academy, ' Academy', '') AS Academy, ROUND(100.0 * SUM(status='Completed') / COUNT(*), 1) AS \"Achievement rate %\" FROM learners WHERE status IN ('Completed','Withdrawn') AND actual_end_date BETWEEN '2025-08-01' AND '2026-07-31' GROUP BY academy ORDER BY 2 DESC",
      "source": "Aptiva learner register"
    }
